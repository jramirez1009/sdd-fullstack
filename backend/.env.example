# Copiar este archivo a `backend/.env` y rellenar los valores reales.
# `.env` está excluido por .gitignore y no debe versionarse nunca.

# Cadena de conexión a la base PostgreSQL alojada en Supabase.
# Formato: postgresql://<usuario>:<password>@<host>:<puerto>/<base>
DATABASE_URL=postgresql://usuario:password@host:5432/postgres

# Secreto simétrico para firmar los JWT (HS256).
# Debe medir al menos 32 caracteres; el servidor se niega a arrancar si no.
# Generar uno con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=cambiar-por-un-secreto-aleatorio-de-al-menos-32-caracteres

# Duración del token emitido en el login. Acepta el formato de `jsonwebtoken` (24h, 7d, 3600).
JWT_EXPIRACION=24h

# Puerto en el que escucha la API.
PORT=3000
