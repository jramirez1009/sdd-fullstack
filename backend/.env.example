# Copiar este archivo a `backend/.env` y rellenar los valores reales.
# `.env` está excluido por .gitignore y no debe versionarse nunca.

# Cadena de conexión a la base PostgreSQL alojada en Supabase.
# Formato: postgresql://<usuario>:<password>@<host>:<puerto>/<base>
DATABASE_URL=postgresql://usuario:password@host:5432/postgres

# Secreto simétrico para firmar los JWT (HS256).
# Debe medir al menos 32 caracteres; el servidor se niega a arrancar si no.
# Generar uno con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=cambiar-por-un-secreto-aleatorio-de-al-menos-32-caracteres

# Duración del token emitido en el login. Acepta el formato de `jsonwebtoken` (24h, 7d, 3600).
JWT_EXPIRACION=24h

# Puerto en el que escucha la API.
PORT=3000

# --- Límite de peticiones -----------------------------------------------------
# Todas estas variables son opcionales: ausentes rigen los valores por defecto
# que se indican. Un valor presente que no sea un entero positivo impide arrancar.

# Ventana y máximo del límite general, que cubre toda la API.
# Por defecto: 100 peticiones por minuto y dirección IP.
RATE_LIMIT_VENTANA_MS=60000
RATE_LIMIT_MAX=100

# Ventana y máximo del límite reforzado que se suma al general sobre
# POST /api/auth/login, para encarecer la fuerza bruta contra contraseñas.
# Por defecto: 10 intentos por cuarto de hora y dirección IP.
RATE_LIMIT_LOGIN_VENTANA_MS=900000
RATE_LIMIT_LOGIN_MAX=10

# --- Registro de peticiones ---------------------------------------------------

# Formato de las entradas del registro. `legible` (por defecto) escribe una línea
# alineada para leerla en una terminal; `json` escribe una línea por entrada,
# apta para un agregador. Cualquier otro valor impide arrancar.
LOG_FORMATO=legible

# Nivel del registro. `info` (por defecto) escribe una entrada por petición;
# `silencio` no escribe ninguna, útil para no sepultar la salida de los tests.
# Cualquier otro valor impide arrancar.
LOG_NIVEL=info

# --- Origen de la petición ----------------------------------------------------

# Si confiar en las cabeceras de reenvío (X-Forwarded-For) para determinar la IP
# que el límite imputa. Admite `false` (por defecto), `true` o el número de
# proxies de confianza que hay delante.
#
# Consecuencias de equivocarse en ambos sentidos:
#   - Desplegar tras un proxy inverso dejándolo en `false`: todas las peticiones
#     llegan con la dirección del proxy, comparten un único contador y se
#     bloquean colectivamente en cuanto un usuario cualquiera agote la cuota.
#   - Activarlo sin un proxy delante: cualquier cliente puede falsificar
#     X-Forwarded-For y estrenar un contador nuevo en cada petición, con lo que
#     el límite deja de proteger nada.
TRUST_PROXY=false
